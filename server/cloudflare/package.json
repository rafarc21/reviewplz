{
  "name": "reviewplz-server-cloudflare",
  "version": "0.1.0",
  "private": true,
  "description": "Reviewplz reference backend — Cloudflare Pages Functions + D1",
  "scripts": {
    "db:create": "wrangler d1 create reviewplz",
    "db:schema": "wrangler d1 execute reviewplz --remote --file=schema.sql",
    "deploy": "bash deploy.sh",
    "dev": "wrangler pages dev public"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240000.0",
    "wrangler": "^3.80.0"
  }
}
